{
  "name": "ourhangout-backend",
  "version": "0.1.0",
  "description": "Our Hangout backend for Synology NAS deployment",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "migration:preflight": "tsx src/scripts/migrationPreflight.ts",
    "seed": "tsx src/scripts/seed.ts",
    "connector:dev": "tsx src/scripts/openclawConnectorClient.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.3.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "google-auth-library": "^10.9.0",
    "ioredis": "^5.11.1",
    "nanoid": "^5.1.16",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
