NODE_ENV=development
PORT=3000
TRUST_PROXY=false

POSTGRES_DB=ourhangout
POSTGRES_USER=ourhangout
POSTGRES_PASSWORD=ourhangout_dev_pw
DATABASE_URL=postgresql://ourhangout:ourhangout_dev_pw@postgres:5432/ourhangout
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
MIGRATION_STATEMENT_TIMEOUT_MS=0
MIGRATION_LOCK_TIMEOUT_MS=30000
REDIS_URL=redis://redis:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_MAX_RETRIES_PER_REQUEST=2

JWT_SECRET=replace-with-a-very-long-random-secret-value-32chars+
PUBLIC_BASE_URL=http://localhost:3000
MEDIA_STORAGE_DIR=storage/media
MEDIA_USER_QUOTA_BYTES=2147483648
MEDIA_PENDING_LIMIT=20
APP_UPDATE_STORAGE_DIR=storage/app-updates
HTTP_BODY_LIMIT_BYTES=1048576
BINARY_BODY_LIMIT_BYTES=209715200
BINARY_UPLOAD_CONCURRENCY=2
BINARY_UPLOAD_QUEUE_LIMIT=20
BINARY_UPLOAD_QUEUE_TIMEOUT_MS=15000
HTTP_CONNECTION_TIMEOUT_MS=10000
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_HANDLER_TIMEOUT_MS=60000
WEBSOCKET_MAX_PAYLOAD_BYTES=65536
# Empty enables Swagger in development and disables it in production.
SWAGGER_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
ALLOW_PUBLIC_PARENT_SIGNUP=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_ANDROID_CHANNEL_ID=messages
FCM_TIMEOUT_MS=5000
FCM_SEND_BUDGET_MS=20000
FCM_SERVICE_ACCOUNT_JSON=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_HASH_COST=12

# Leave both empty to disable Guardian Console login. Never reuse example credentials.
GUARDIAN_CONSOLE_LOGIN_ID=
GUARDIAN_CONSOLE_PASSWORD=
GUARDIAN_CONSOLE_ACCESS_TOKEN_TTL=8h

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_REDIS_NAMESPACE=ourhangout-rate-limit-
RATE_LIMIT_SKIP_ON_ERROR=false

PAIRING_CODE_TTL_SECONDS=300
LOG_LEVEL=info
